{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Token-budgeted, failover-capable streaming LLM gateway (reference implementation)",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/infrastructure/redis/lua', 'dist/infrastructure/redis/lua', { recursive: true })\"",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project contract",
    "test:integration": "vitest run --project integration --project concurrency",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "mint-token": "tsx scripts/mint-token.ts",
    "close-attempt": "tsx --env-file-if-exists=.env scripts/close-attempt.ts",
    "fake-provider": "tsx scripts/fake-provider-server.ts",
    "load-test": "tsx scripts/load-test/run.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "gpt-tokenizer": "4.0.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/autocannon": "7.12.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "autocannon": "8.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
