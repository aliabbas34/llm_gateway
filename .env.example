# Copy to .env for local development. .env is git-ignored; never commit real keys.
# Every variable is documented in src/config/schema.ts.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Prometheus /metrics on a separate, internal-only listener.
METRICS_HOST=0.0.0.0
METRICS_PORT=9464
# Number of trusted reverse-proxy hops in front of the gateway (0 = none). ADR-0009.
TRUST_PROXY_HOPS=0
# Exact browser origins allowed to call the gateway (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_DRAIN_TIMEOUT_MS=25000

# --- Infrastructure (docker compose up -d) ---
REDIS_URL=redis://localhost:6380
REDIS_COMMAND_TIMEOUT_MS=500
DATABASE_URL=postgres://gateway:gateway@localhost:5433/gateway
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=2000

# --- Auth ---
# Paste the line printed by `npm run gen-keys` (public key only; the private key stays in keys/).
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
JWT_CLOCK_TOLERANCE_SEC=5
# Shared secret for POST /v1/attempts/:id/close (>= 32 chars). e.g. `openssl rand -hex 32`
SERVICE_API_KEY=replace-with-at-least-32-random-characters

# --- Attempts ---
ATTEMPT_TTL_SECONDS=2592000

# --- Models & providers (ADR-0002) ---
# provider:model. The client never chooses the model.
PRIMARY_MODEL=groq:llama-3.3-70b-versatile
# Ordered failover chain (comma separated). Empty = no failover.
FALLBACK_MODELS=mistral:mistral-small-latest
# Keys stay server-side. A provider referenced above must have its key set, or startup fails.
GROQ_API_KEY=
MISTRAL_API_KEY=
# Optional overrides
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Local development without keys: run `npm run fake-provider` and use
#   FAKE_PROVIDER_BASE_URL=http://localhost:8090/v1  PRIMARY_MODEL=fake:ok?words=40&gap=20  FALLBACK_MODELS=
# FAKE_PROVIDER_BASE_URL=http://localhost:8090/v1
# SYSTEM_PROMPT=You are an AI assistant helping a student during a timed coding-interview practice session.
TOKEN_ESTIMATE_MULTIPLIER=1.1

# --- Budget (FR5) ---
# Reject when the completion that still fits would be this small or smaller.
BUDGET_MIN_USEFUL_TOKENS=16
# Must be >= MAX_STREAM_DURATION_MS + 30000 (ADR-0011).
RESERVATION_TTL_MS=360000
MAX_STREAM_DURATION_MS=300000

# --- Streaming timeouts (FR6, ADR-0017) ---
PROVIDER_TTFT_TIMEOUT_MS=10000
PROVIDER_IDLE_TIMEOUT_MS=20000
SSE_WRITE_TIMEOUT_MS=30000

# --- Crash-recovery sweeper (ADR-0005) ---
SWEEPER_INTERVAL_MS=15000
SWEEPER_BATCH_SIZE=200

# --- Rate limits (FR4), requests per minute ---
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_ATTEMPT_PER_MINUTE=20
